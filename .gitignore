# Local testing noise.
*.log
*.csv
__pycache__/
*.pyc

# Local working directories: scratch, build output, release staging, and
# session logs. None of it belongs in a clone, and none of it may be
# redistributed. Treat everything under these as local-only.
/build/
/dist/
/recovery/
