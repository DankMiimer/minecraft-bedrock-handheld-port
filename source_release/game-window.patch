 void EGLUTWindow::makeCurrent(bool active) {
+    const char* crustyBridgeEnv = std::getenv("GAMEWINDOW_EGLUT_CRUSTY_CONTEXT");
+    if (crustyBridgeEnv && *crustyBridgeEnv && strcmp(crustyBridgeEnv, "0") != 0) {
+        // The matching runtime bridge records Crusty's SDL handles through
+        // normal symbol interposition and exposes this stable API. No private
+        // data address from a particular Westonpack build is read here.
+        using ContextApiV1 = int (*)(unsigned int, int);
+        static auto contextApi = reinterpret_cast<ContextApiV1>(
+            dlsym(RTLD_DEFAULT, "crusty_gamewindow_context_v1"));
+        if (contextApi) {
+            int result = contextApi(1U, active ? 1 : 0);
+            if (result == 0)
+                return;
+            fprintf(stderr, "EGLUT crusty context API v1 unavailable: %d; "
+                            "using native EGL context path\n", result);
+        }
+        // No crusty bridge in this process (for example a Panfrost bypass):
+        // continue through the native EGL path. The launcher validates that
+        // the bridge module exists before enabling a Crusty backend.
+        static bool warned = false;
+        if (!warned) {
+            fprintf(stderr, "EGLUT crusty context API v1 unavailable; "
+                            "using native EGL context path\n");
+            warned = true;
+        }
+    }
+
 #ifdef GAMEWINDOW_X11_LOCK
     std::lock_guard<std::recursive_mutex> lock(x11_sync);
 #endif
@@ -75,6 +105,8 @@ void EGLUTWindow::show() {
     eglutShowWindow();
     currentWindow = this;
     addWindowToGamepadManager();
+    if (std::getenv("GAMEWINDOW_EGLUT_FORCE_FOCUS"))
+        LinuxGamepadJoystickManager::instance.onWindowFocused(this, true);
 }
 
