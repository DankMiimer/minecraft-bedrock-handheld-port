+// --- Device memory ------------------------------------------------------------
+// Android asks three separate memory questions and Bedrock uses the answers
+// for three different things, but upstream answers all of them with physical
+// RAM. On a handheld that is wrong in both directions at once, so the port
+// measures the device (lib/performance.sh) and hands the answers in.
+//
+//   MCPE_GAME_MEMORY_BUDGET_MB  physical RAM minus what the firmware, the
+//                               frontend, Weston and this process already
+//                               hold. Unset means "answer as upstream did".
+static long long mcpeMemoryBudgetBytes() {
+    static long long budget = []() -> long long {
+        const char *value = std::getenv("MCPE_GAME_MEMORY_BUDGET_MB");
+        if(value == nullptr || *value == '\0')
+            return 0;
+        char *end = nullptr;
+        long long parsed = std::strtoll(value, &end, 10);
+        if(end == value || *end != '\0' || parsed < 64 || parsed > 65536) {
+            Log::warn("Memory", "Ignoring unusable MCPE_GAME_MEMORY_BUDGET_MB=%s",
+                      value);
+            return 0;
+        }
+        return parsed * 1024LL * 1024LL;
+    }();
+    return budget;
+}
+
+// Linux keeps every otherwise-idle page in the page cache, so sysinfo()'s
+// freeram is not "memory the game may have". Measured on the reference
+// RG34XX-SP, idle with the frontend resident: freeram 484 MB against a
+// MemAvailable of 1643 MB out of 1979 MB total, because 1179 MB of it is
+// buffers and page cache the kernel would hand back on demand. The port's own
+// asset prewarm in weston_launch.sh drives freeram lower still, by design. In
+// a loaded world it reaches 33 MB against 1078 MB available. MemAvailable is
+// the kernel's own answer to the question Bedrock is asking.
+//
+// Measured caveat: an A/B against the pre-change client on the 2 GB reference
+// device found no frame-rate difference and no stutter on either side, so the
+// old figure was wrong without being costly there -- peak RSS was 632 MB,
+// far from either limit. This is a correctness fix whose performance effect,
+// if any, belongs to smaller devices where the budget actually binds.
+static long long mcpeAvailableBytes() {
+    using Clock = std::chrono::steady_clock;
+    // Reading /proc/meminfo costs far more than the single sysinfo() call it
+    // replaces, and nothing here moves meaningfully inside half a second, so
+    // the answer is held briefly however often the game asks for it.
+    static std::atomic<long long> cachedBytes{0};
+    static std::atomic<long long> cachedAtMs{0};
+    auto nowMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+        Clock::now().time_since_epoch()).count();
+    long long cached = cachedBytes.load(std::memory_order_relaxed);
+    if(cached > 0 && nowMs - cachedAtMs.load(std::memory_order_relaxed) < 500)
+        return cached;
+
+    long long availableKb = -1;
+    if(FILE *meminfo = std::fopen("/proc/meminfo", "r")) {
+        char line[128];
+        while(std::fgets(line, sizeof(line), meminfo)) {
+            if(std::strncmp(line, "MemAvailable:", 13) == 0) {
+                availableKb = std::strtoll(line + 13, nullptr, 10);
+                break;
+            }
+        }
+        std::fclose(meminfo);
+    }
+
+    long long bytes = 0;
+    if(availableKb >= 0) {
+        bytes = availableKb * 1024LL;
+    } else {
+#if !defined(__APPLE__) && !defined(__FreeBSD__)
+        // Kernels before 3.14 have no MemAvailable, and sysinfo() is the only
+        // header this file has on those platforms anyway. Free plus the
+        // reclaimable buffers is the closest it can offer.
+        struct sysinfo memInfo;
+        if(sysinfo(&memInfo) == 0)
+            bytes = (long long)(memInfo.freeram + memInfo.bufferram) *
+                    memInfo.mem_unit;
+#endif
+    }
+    if(bytes > 0) {
+        cachedBytes.store(bytes, std::memory_order_relaxed);
+        cachedAtMs.store(nowMs, std::memory_order_relaxed);
+    }
+    return bytes;
+}
