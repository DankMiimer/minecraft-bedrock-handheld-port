+static void patchOldHttpResolveCrash(void *handle) {
+    const char *disabled = std::getenv("MCPE_PATCH_HTTP_RESOLVE");
+    if(disabled != nullptr && std::strcmp(disabled, "0") == 0)
+        return;
+#if !defined(__aarch64__)
+    return;
+#endif
+
