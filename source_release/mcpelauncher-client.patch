index 0000000..9ff100a
--- /dev/null
+++ b/src/ui_layout_scale.h
@@ -0,0 +1,77 @@
+#pragma once
+// Phase 1 of the handheld UI viewport experiment; see docs/UI-SCALING.md.
+//
+// 1.21 lays its JSON UI out from the drawing surface it is told about, not from
+// the Android display metrics: an earlier build lied to
+// MainActivity::getScreenWidth and nothing moved. The two queries that actually
+// report the surface are fake_egl::eglQuerySurface (EGL_WIDTH/EGL_HEIGHT) and
+// ANativeWindow_getWidth/getHeight, and both read GameWindow::getWindowSize.
+// This header shrinks exactly those two answers and nothing else.
+//
+// MCPE_UI_LAYOUT_SCALE=1.5 reports a surface 1/1.5 the real size, so the engine
+// lays the interface out coarser. Rendering is deliberately NOT corrected here:
+// the game draws into only part of the panel and pointer mapping is untouched,
+// so this is a diagnostic, not a usable mode. It isolates the one open
+// question - does layout follow these queries? - from the glViewport/glScissor
+// and input work a shippable version needs.
+//
+// Unset, empty, unparsable, <= 1.0 or > 4.0 all mean off, so a default build
+// behaves exactly as it did before.
+
+#include <cstdlib>
+
+namespace mcpe_ui_layout {
+
+inline double scale() {
+    static const double value = []() -> double {
+        const char *raw = std::getenv("MCPE_UI_LAYOUT_SCALE");
+        if(!raw || !*raw)
+            return 1.0;
+        char *end = nullptr;
+        double parsed = std::strtod(raw, &end);
+        // The negated comparisons also reject NaN.
+        if(end == raw || !(parsed > 1.0) || !(parsed <= 4.0))
+            return 1.0;
+        return parsed;
+    }();
+    return value;
+}
+
+inline bool active() {
+    return scale() > 1.0;
+}
+
+// Never report less than 1: a zero or negative dimension would divide by zero
+// somewhere in the engine's layout maths.
+inline int extent(int real) {
+    if(!active() || real <= 0)
+        return real;
+    int scaled = (int)(real / scale());
+    return scaled < 1 ? 1 : scaled;
+}
+
+// --- Phase 2: scale rendering back up to the panel ---------------------------
+// The game lays out and draws inside the smaller surface it was told about, so
+// the viewport and scissor rectangles it sets are in that space. Scaling them
+// back up makes the result cover the whole panel again. This multiplies
+// geometry before rasterisation instead of upscaling a finished image, so it
+// does not soften the way the launcher's display-scaler UI zoom does.
+//
+// Pointer input is deliberately NOT converted here. The reference handheld is
+// gamepad-driven and its menus navigate by focus, so nothing on it reads
+// pointer coordinates; and the same handlers feed the launcher's own ImGui
+// overlay, which lives in panel space and would break if they were scaled
+// wholesale. A device that delivers real touch or mouse events still needs the
+// inverse factor applied where those reach the game, not where they arrive.
+
+// Convert one surface-space edge to panel space. Edges are converted rather
+// than (origin, size) pairs, so two rectangles that share an edge round it the
+// same way and cannot leave a seam between them.
+inline int toPanel(int surfaceEdge) {
+    if(!active())
+        return surfaceEdge;
+    double scaled = surfaceEdge * scale();
+    return (int)(scaled < 0 ? scaled - 0.5 : scaled + 0.5);
+}
+
+}  // namespace mcpe_ui_layout
