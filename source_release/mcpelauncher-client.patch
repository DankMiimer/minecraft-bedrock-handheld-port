+
+// Only the default framebuffer shows the lie: an offscreen target has its own
+// resolution and must be left alone.
+//
+// Deliberately not thread_local. Measured on the reference device: adding one
+// thread_local to this executable aborted the game in shim::assert_impl with
+// "stack corruption has been detected" about seven seconds in, before the first
+// frame, and it did so whether or not the scaling was switched on -- so it was
+// the TLS segment growing at load time, not this code running. The Android
+// libraries come in through mcpelauncher-linker with libc-shim emulating
+// bionic's TLS slots, and that arrangement does not tolerate the executable
+// gaining TLS. A plain global is also what this actually needs: the game issues
+// its GL on one thread and a context is current on one thread at a time.
+bool drawingToPanel = true;
+
+void scaledRect(int x, int y, int width, int height, void (*sink)(int, int, int, int)) {
+    if(!drawingToPanel) {
+        sink(x, y, width, height);
+        return;
+    }
+    int x0 = mcpe_ui_layout::toPanel(x);
+    int y0 = mcpe_ui_layout::toPanel(y);
+    sink(x0, y0, mcpe_ui_layout::toPanel(x + width) - x0,
+         mcpe_ui_layout::toPanel(y + height) - y0);
+}
