+    // Android's memory limit is this app's share, not the machine's RAM.
+    long long total = getTotalMemory();
+    long long budget = mcpeMemoryBudgetBytes();
+    long long limit = (budget > 0 && budget < total) ? budget : total;
+    static bool logged = false;
+    if(!logged) {
+        logged = true;
+        Log::info("Memory", "total=%lld MB limit=%lld MB (%s)",
+                  total / (1024 * 1024), limit / (1024 * 1024),
+                  budget > 0 ? "measured budget"
+                             : "no budget set, reporting physical RAM");
+    }
+    return limit;
 }
 
 FakeJni::JLong MainActivity::getAvailableMemory() {
-    return getTotalMemory();
+    long long limit = getMemoryLimit();
+    long long available = mcpeAvailableBytes();
+    if(available <= 0 || available > limit)
+        return limit;
+    return available;
 }
 
